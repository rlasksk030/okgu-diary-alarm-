{
  "name": "okgu-diary-fast",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "seed": "node --use-env-proxy --import tsx scripts/seed.mjs",
    "test": "node --use-env-proxy --import tsx --test tests/*.test.mjs",
    "test:browser": "node --import tsx scripts/browser-test.mjs",
    "test:load": "node --use-env-proxy scripts/load-test.mjs",
    "build:trial": "node scripts/build-trial.mjs",
    "migrate": "node --import tsx scripts/migrate.mjs",
    "backup": "node --import tsx scripts/backup.mjs",
    "check": "tsc --noEmit",
    "build": "node scripts/build-trial.mjs",
    "build:local": "node scripts/build-trial.mjs --local",
    "deploy:trial": "node --use-env-proxy scripts/deploy-trial.mjs",
    "restore:rehearsal": "node --import tsx scripts/restore-rehearsal.mjs",
    "migrate:delta:rehearsal": "node --import tsx scripts/delta-rehearsal.mjs",
    "test:load:browser": "node scripts/browser-load-test.mjs",
    "trial:provision": "node --use-env-proxy scripts/provision-trial.mjs",
    "profile:login": "node --use-env-proxy --import tsx scripts/profile-login.mjs",
    "trial:launch": "node --use-env-proxy scripts/launch-trial.mjs",
    "trial:measure": "node --use-env-proxy scripts/measure-trial.mjs",
    "test:visit": "node scripts/first-visit-test.mjs",
    "profile:login:cpu": "node --import tsx scripts/profile-login-cpu.mjs",
    "trial:trace-login": "node --use-env-proxy --import tsx scripts/trace-trial-login.mjs",
    "test:ui:main": "node scripts/compare-main-ui.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "tsx": "4.20.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261002.1",
    "@types/node": "24.10.1",
    "https-proxy-agent": "7.0.6",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "wrangler": "4.146.0",
    "ws": "8.21.0"
  }
}
