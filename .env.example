# Values belong in Codex environment settings or Cloudflare build settings, never Git.
# Local development requires none of these credentials.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
OKGU_TRIAL_D1_DATABASE_ID=
OKGU_TRIAL_FRONTEND_ORIGIN=https://okgu-diary-pages-trial.rlasksk030.workers.dev
# Optional trial API origin when testing cross-origin Pages frontend
OKGU_TRIAL_API_ORIGIN=https://okgu-diary-trial.rlasksk030.workers.dev
# Synthetic data only; enables explicit remote seed command
OKGU_ALLOW_SYNTHETIC_TRIAL_SEED=
# Public key only. Private VAPID key remains on the existing push server.
VAPID_PUBLIC_KEY=
# Production-only worker secret, absent from trial. Operational migration approved;
# actual source backup/comparison and old-alarm shutdown still gate activation.
# PUSH_SERVER_SECRET=
# Offline production candidate only; does not deploy, import or modify Pages.
OKGU_PRODUCTION_API_ORIGIN=https://okgu-diary-api.rlasksk030.workers.dev
OKGU_PRODUCTION_D1_DATABASE_ID=
# AES-256 key for offline encrypted backups, 64 hex characters
OKGU_BACKUP_KEY=

# Optional synthetic-only real GitHub browser origin check; no Pages deployment
OKGU_TRIAL_PAGES_CORS=
# Trial write freeze; active is the default. Never enable for production without approval.
OKGU_TRIAL_WRITE_MODE=active
