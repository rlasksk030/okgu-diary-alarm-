{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "okgu-diary-trial",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "./trial-web", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "vars": {
    "WEB_ORIGINS": "http://127.0.0.1:3020,http://localhost:3020",
    "APP_URL": "http://127.0.0.1:3020/okgu-diary-alarm-/",
    "PUSH_MODE": "disabled"
  },
  "d1_databases": [{"binding": "DB", "database_name": "okgu-diary-trial", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations"}],
  "r2_buckets": [{"binding": "PHOTOS", "bucket_name": "okgu-diary-trial-private"}],
  "triggers": {"crons": ["0 13 * * *", "* * * * *", "0 4 * * *"]},
  "observability": {"enabled": false}
}
